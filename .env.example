# microshort 2 — local development environment
#
# Copy to .env before `docker compose up`. These values are ONLY for the local
# compose stack. Every real deployment injects the same variables through its
# own mechanism (systemd EnvironmentFile, Kubernetes Secret, SSM, ...).
#
# Rule: no service has a default for a URL or a secret. If one of these is
# missing the service exits at startup with a message naming the variable.

# ---- shared secrets --------------------------------------------------------
POSTGRES_PASSWORD=change-me-local-only
JWT_SECRET=change-me-local-only-needs-at-least-32-characters
SERVICE_TOKEN=change-me-local-only-service-token

# ---- api -------------------------------------------------------------------
# What short URLs are built from. In the compose stack this is the redirect
# service as seen from the host.
PUBLIC_BASE_URL=http://localhost:8080
# CORS allow-list for the dashboard origin. "*" allows every origin.
ALLOWED_ORIGINS=http://localhost:3001
# Optional path prefix when api sits behind a path-routing proxy (e.g. /api).
BASE_PATH=
# Optional comma-separated name=url pairs the admin health page will probe.
HEALTH_TARGETS=redirect=http://redirect:8080,web=http://web:3001
# Single sign-on through an AWS Application Load Balancer (contract 4a).
# Off here; a deployment behind an authenticating ALB sets all three:
#   AUTH_TRUSTED_PROXY=alb
#   AUTH_TRUSTED_PROXY_SIGNER=arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/app/name/id
#   AUTH_TRUSTED_PROXY_ADMINS=admin@example.test
AUTH_TRUSTED_PROXY=

# ---- redirect --------------------------------------------------------------
CACHE_TTL_SECONDS=60

# ---- web -------------------------------------------------------------------
# What the BROWSER uses to reach api. Must be reachable from the user's machine.
API_BASE_URL=http://localhost:3000
